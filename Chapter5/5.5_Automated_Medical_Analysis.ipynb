    "for i in range(16):\n",
    "    ax = axes[i // 4, i % 4]\n",
    "\n",
    "    img = generated_samples[i].cpu().numpy().transpose(1, 2, 0)\n",
    "    img = (img + 1) / 2.0\n",
    "    img = np.clip(img, 0, 1)\n",
    "\n",
    "    ax.imshow(img)\n",
