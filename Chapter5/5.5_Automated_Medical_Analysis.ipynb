   "id": "02cf431d",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# 랜덤 생성\n",
    "generator.eval()\n",
    "\n",
    "num_samples = 16\n",
    "z_samples = torch.randn(num_samples, 512).to(device)\n",
    "\n",
    "with torch.no_grad():\n",
    "    generated_samples = generator(z_samples)"
   ]
  },
