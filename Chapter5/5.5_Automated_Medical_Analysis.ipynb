     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "DATA_DIR = './data/pathology'\n",
    "os.makedirs(DATA_DIR, exist_ok=True)\n",
    "\n",
    "print(f\"데이터 경로: {DATA_DIR}\")\n",
    "\n",
    "# 조직 클래스\n",
    "TISSUE_CLASSES = ['ADI', 'BACK', 'DEB', 'LYM', 'MUC', 'MUS', 'NORM', 'STR', 'TUM']\n",
    "\n",
    "print(f\"\\n조직 클래스 ({len(TISSUE_CLASSES)}개):\")\n",
    "for i, cls in enumerate(TISSUE_CLASSES, 1):\n",
    "    print(f\"  {i}. {cls}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "523c4ba7",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 4. 데이터 전처리\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5079d006",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "transform = transforms.Compose([\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.5, 0.5, 0.5], std=[0.5, 0.5, 0.5])  # [-1, 1]\n",
    "])\n",
    "\n",
    "print(\"✅ Transform 정의 완료\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5762b408",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 5. 정상 조직(NORM) 데이터 로드\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d9043c00",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# 정상 조직 이미지 경로\n",
    "NORM_DIR = Path(DATA_DIR) / 'NCT-CRC-HE-100K' / 'NORM'\n",
    "\n",
    "if NORM_DIR.exists():\n",
    "    image_paths = list(NORM_DIR.glob('*.tif'))\n",
    "    print(f\"✅ 정상 조직 이미지: {len(image_paths)}개\")\n",
    "\n",
    "    # 샘플 이미지 로드 (메모리 절약)\n",
    "    MAX_SAMPLES = 1000\n",
    "    if len(image_paths) > MAX_SAMPLES:\n",
    "        image_paths = image_paths[:MAX_SAMPLES]\n",
    "        print(f\"  → {MAX_SAMPLES}개로 제한\")\n",
    "else:\n",
    "    print(f\"⚠️  디렉토리가 없습니다: {NORM_DIR}\")\n",
    "    print(\"데이터 다운로드 후 다시 실행하세요.\")\n",
    "    image_paths = []"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b67a6610",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 6. StyleGAN Generator 구성 요소\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f6f0dda4",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# Mapping Network (Z → W)\n",
    "class MappingNetwork(nn.Module):\n",
    "    def __init__(self, z_dim=512, w_dim=512, num_layers=8):\n",
    "        super().__init__()\n",
    "\n",
    "        layers = []\n",
    "        for i in range(num_layers):\n",
    "            in_dim = z_dim if i == 0 else w_dim\n",
    "            layers.extend([\n",
    "                nn.Linear(in_dim, w_dim),\n",
    "                nn.LeakyReLU(0.2)\n",
    "            ])\n",
    "\n",
    "        self.mapping = nn.Sequential(*layers)\n",
    "\n",
    "    def forward(self, z):\n",
    "        return self.mapping(z)\n",
    "\n",
    "print(\"✅ Mapping Network 정의\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6c4a9306",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# Adaptive Instance Normalization (AdaIN)\n",
    "class AdaIN(nn.Module):\n",
    "    def __init__(self, num_features, w_dim):\n",
    "        super().__init__()\n",
    "        self.style_scale = nn.Linear(w_dim, num_features)\n",
    "        self.style_shift = nn.Linear(w_dim, num_features)\n",
    "\n",
    "    def forward(self, x, w):\n",
    "        x_normalized = F.instance_norm(x)\n",
    "        scale = self.style_scale(w).unsqueeze(2).unsqueeze(3)\n",
    "        shift = self.style_shift(w).unsqueeze(2).unsqueeze(3)\n",
    "        return scale * x_normalized + shift\n",
    "\n",
    "print(\"✅ AdaIN 정의\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "43108bb1",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# Style Block\n",
    "class StyleBlock(nn.Module):\n",
    "    def __init__(self, in_channels, out_channels, w_dim, upsample=True):\n",
    "        super().__init__()\n",
    "\n",
    "        self.upsample = upsample\n",
    "        if upsample:\n",
    "            self.up = nn.Upsample(scale_factor=2, mode='bilinear', align_corners=False)\n",
    "\n",
    "        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1)\n",
    "        self.adain = AdaIN(out_channels, w_dim)\n",
    "        self.activation = nn.LeakyReLU(0.2)\n",
    "        self.noise_strength = nn.Parameter(torch.zeros(1))\n",
    "\n",
    "    def forward(self, x, w):\n",
    "        if self.upsample:\n",
    "            x = self.up(x)\n",
    "\n",
    "        x = self.conv(x)\n",
    "\n",
    "        # Noise injection\n",
    "        noise = torch.randn_like(x) * self.noise_strength\n",
    "        x = x + noise\n",
    "\n",
    "        x = self.adain(x, w)\n",
    "        x = self.activation(x)\n",
    "\n",
    "        return x\n",
    "\n",
    "print(\"✅ StyleBlock 정의\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "638b7cbe",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 7. StyleGAN Generator 모델\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "32880891",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "class StyleGAN_Generator(nn.Module):\n",
    "    def __init__(self, z_dim=512, w_dim=512, img_channels=3):\n",
    "        super().__init__()\n",
    "\n",
    "        self.z_dim = z_dim\n",
    "        self.mapping = MappingNetwork(z_dim, w_dim)\n",
    "\n",
    "        # Constant input (4×4)\n",
    "        self.const_input = nn.Parameter(torch.randn(1, 512, 4, 4))\n",
    "\n",
    "        # Synthesis blocks\n",
    "        self.style_blocks = nn.ModuleList([\n",
    "            StyleBlock(512, 512, w_dim, upsample=True),   # 4→8\n",
    "            StyleBlock(512, 512, w_dim, upsample=True),   # 8→16\n",
    "            StyleBlock(512, 256, w_dim, upsample=True),   # 16→32\n",
    "            StyleBlock(256, 128, w_dim, upsample=True),   # 32→64\n",
    "            StyleBlock(128, 64, w_dim, upsample=True),    # 64→128\n",
    "            StyleBlock(64, 32, w_dim, upsample=False),    # 128→128\n",
    "        ])\n",
    "\n",
    "        # To RGB\n",
    "        self.to_rgb = nn.Sequential(\n",
    "            nn.Conv2d(32, img_channels, kernel_size=1),\n",
    "            nn.Upsample(size=(224, 224), mode='bilinear', align_corners=False),\n",
    "            nn.Tanh()\n",
    "        )\n",
    "\n",
    "    def forward(self, z):\n",
    "        batch_size = z.size(0)\n",
    "\n",
    "        # Mapping\n",
    "        w = self.mapping(z)\n",
    "\n",
    "        # Constant input\n",
    "        x = self.const_input.repeat(batch_size, 1, 1, 1)\n",
    "\n",
    "        # Style blocks\n",
    "        for block in self.style_blocks:\n",
    "            x = block(x, w)\n",
    "\n",
    "        # To RGB\n",
    "        image = self.to_rgb(x)\n",
    "\n",
    "        return image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "45775c07",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# Generator 생성\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "\n",
    "generator = StyleGAN_Generator(z_dim=512, w_dim=512).to(device)\n",
    "\n",
    "num_params = sum(p.numel() for p in generator.parameters())\n",
    "print(f\"✅ Generator 생성 완료\")\n",
    "print(f\"  - 파라미터 수: {num_params:,}\")\n",
    "print(f\"  - 디바이스: {device}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "edd3f373",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 8. Discriminator 모델\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1293c20a",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "class PatchDiscriminator(nn.Module):\n",
    "    def __init__(self, img_channels=3):\n",
    "        super().__init__()\n",
    "\n",
    "        self.model = nn.Sequential(\n",
    "            # 224→112\n",
    "            nn.Conv2d(img_channels, 64, kernel_size=4, stride=2, padding=1),\n",
    "            nn.LeakyReLU(0.2),\n",
    "\n",
    "            # 112→56\n",
    "            nn.Conv2d(64, 128, kernel_size=4, stride=2, padding=1),\n",
    "            nn.InstanceNorm2d(128),\n",
    "            nn.LeakyReLU(0.2),\n",
    "\n",
    "            # 56→28\n",
    "            nn.Conv2d(128, 256, kernel_size=4, stride=2, padding=1),\n",
    "            nn.InstanceNorm2d(256),\n",
    "            nn.LeakyReLU(0.2),\n",
    "\n",
    "            # 28→14\n",
    "            nn.Conv2d(256, 512, kernel_size=4, stride=2, padding=1),\n",
    "            nn.InstanceNorm2d(512),\n",
    "            nn.LeakyReLU(0.2),\n",
    "\n",
    "            # 14→7\n",
    "            nn.Conv2d(512, 1, kernel_size=4, stride=1, padding=1)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.model(x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6030ee91",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "discriminator = PatchDiscriminator().to(device)\n",
    "\n",
    "print(f\"✅ Discriminator 생성 완료\")\n",
    "print(f\"  - 파라미터 수: {sum(p.numel() for p in discriminator.parameters()):,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3727d336",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 9. 더미 입력 테스트\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0a971934",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# 더미 latent code\n",
    "z_test = torch.randn(4, 512).to(device)\n",
    "\n",
    "# Generator 테스트\n",
    "generator.eval()\n",
    "with torch.no_grad():\n",
    "    generated_images = generator(z_test)\n",
    "\n",
    "print(f\"✅ Generator 테스트 완료\")\n",
    "print(f\"  - 입력 (z): {z_test.shape}\")\n",
    "print(f\"  - 출력 (이미지): {generated_images.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "03b8a54a",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# 생성된 이미지 시각화\n",
    "fig, axes = plt.subplots(1, 4, figsize=(16, 4))\n",
    "\n",
    "for i in range(4):\n",
    "    img = generated_images[i].cpu().detach().numpy().transpose(1, 2, 0)\n",
    "    img = (img + 1) / 2.0  # [-1, 1] → [0, 1]\n",
    "    img = np.clip(img, 0, 1)\n",
    "\n",
    "    axes[i].imshow(img)\n",
    "    axes[i].axis('off')\n",
    "\n",
    "plt.suptitle('Generated Images (Untrained)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ac88e6f3",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 10. 손실 함수 및 최적화\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e3ee22b6",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "criterion = nn.BCEWithLogitsLoss()\n",
    "\n",
    "g_optimizer = torch.optim.Adam(generator.parameters(), lr=0.0002, betas=(0.5, 0.999))\n",
    "d_optimizer = torch.optim.Adam(discriminator.parameters(), lr=0.0002, betas=(0.5, 0.999))\n",
    "\n",
    "print(\"✅ 손실 함수 및 최적화 설정 완료\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "14a84fc0",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 11. 학습 루프 (데모 - 실제 데이터 필요)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c14c6dbd",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# 실제 데이터가 있을 때 실행\n",
    "\"\"\"\n",
    "NUM_EPOCHS = 50\n",
    "BATCH_SIZE = 16\n",
    "\n",
    "for epoch in range(NUM_EPOCHS):\n",
    "    generator.train()\n",
    "    discriminator.train()\n",
    "\n",
    "    g_loss_total = 0\n",
    "    d_loss_total = 0\n",
    "\n",
    "    for real_images in train_loader:\n",
    "        batch_size = real_images.size(0)\n",
    "        real_images = real_images.to(device)\n",
    "\n",
    "        real_labels = torch.ones(batch_size, 1, 7, 7).to(device)\n",
    "        fake_labels = torch.zeros(batch_size, 1, 7, 7).to(device)\n",
    "\n",
    "        # --- Discriminator ---\n",
    "        d_optimizer.zero_grad()\n",
    "\n",
    "        real_outputs = discriminator(real_images)\n",
    "        d_real_loss = criterion(real_outputs, real_labels)\n",
    "\n",
    "        z = torch.randn(batch_size, 512).to(device)\n",
    "        fake_images = generator(z).detach()\n",
    "        fake_outputs = discriminator(fake_images)\n",
    "        d_fake_loss = criterion(fake_outputs, fake_labels)\n",
    "\n",
    "        d_loss = (d_real_loss + d_fake_loss) / 2\n",
    "        d_loss.backward()\n",
    "        d_optimizer.step()\n",
    "\n",
    "        # --- Generator ---\n",
    "        g_optimizer.zero_grad()\n",
    "\n",
    "        z = torch.randn(batch_size, 512).to(device)\n",
    "        fake_images = generator(z)\n",
    "        fake_outputs = discriminator(fake_images)\n",
    "\n",
    "        g_loss = criterion(fake_outputs, real_labels)\n",
    "        g_loss.backward()\n",
    "        g_optimizer.step()\n",
    "\n",
    "        g_loss_total += g_loss.item()\n",
    "        d_loss_total += d_loss.item()\n",
    "\n",
    "    print(f\"Epoch [{epoch+1}/{NUM_EPOCHS}], \"\n",
    "          f\"G Loss: {g_loss_total/len(train_loader):.4f}, \"\n",
    "          f\"D Loss: {d_loss_total/len(train_loader):.4f}\")\n",
    "\"\"\"\n",
    "\n",
    "print(\"학습 루프는 실제 데이터가 있을 때 실행하세요.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5b40af17",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
    "##### 12. 이상 탐지 (Reconstruction Error)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "75ba8373",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# 테스트 이미지로 reconstruction error 계산\n",
    "def calculate_reconstruction_error(generator, test_image, device, iterations=1000):\n",
    "    \"\"\"\n",
    "    최적의 latent code를 찾아 reconstruction error 계산\n",
    "    \"\"\"\n",
    "    generator.eval()\n",
    "\n",
    "    test_image = test_image.unsqueeze(0).to(device)\n",
    "\n",
    "    # Latent code 최적화\n",
    "    z = torch.randn(1, 512, requires_grad=True, device=device)\n",
    "    optimizer = torch.optim.Adam([z], lr=0.01)\n",
    "\n",
    "    for _ in range(iterations):\n",
    "        optimizer.zero_grad()\n",
    "\n",
    "        reconstructed = generator(z)\n",
    "        loss = F.mse_loss(reconstructed, test_image)\n",
    "\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "    # 최종 error\n",
    "    with torch.no_grad():\n",
    "        reconstructed = generator(z)\n",
    "        error = F.mse_loss(reconstructed, test_image).item()\n",
    "\n",
    "    return error, reconstructed.squeeze(0)\n",
    "\n",
    "print(\"✅ 이상 탐지 함수 정의 완료\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a10003da",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "source": [
